    async function renderFullA4PagesDataUrls() {
      const isLandscape = appState.pageOrientation !== "portrait";
      const PAGE_W = isLandscape ? 2339 : 1654;
      const PAGE_H = isLandscape ? 1654 : 2339;
      const perPage = getPhotosPerPage();
      const totalPages = Math.ceil(appState.photos.length / perPage);

      for (const photo of appState.photos) photo.compositeCache = await renderCompositePhotoDataUrl(photo);

      const fontFamily = '"Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif';
      const pageResults = [];

      for (let p = 0; p < totalPages; p++) {
        const pageCanvas = document.createElement("canvas");
        pageCanvas.width = PAGE_W; pageCanvas.height = PAGE_H;
        const ctx = pageCanvas.getContext("2d");
        ctx.fillStyle = "#ffffff"; ctx.fillRect(0, 0, PAGE_W, PAGE_H);

        const marginX = isLandscape ? 64 : 68;
        const marginBottom = isLandscape ? 54 : 68;
        let topY = isLandscape ? 54 : 68;

        if (appState.projectTitle && appState.projectTitle.trim() !== "") {
          ctx.fillStyle = "#0f172a"; ctx.font = "700 32px " + fontFamily;
          ctx.fillText(appState.projectTitle.trim(), marginX, topY);
          topY += 52;
        }

        const availW = PAGE_W - marginX * 2;
        const availH = PAGE_H - topY - marginBottom;
        const pagePhotos = appState.photos.slice(p * perPage, (p + 1) * perPage);

        let cols = 2, rows = 2;
        if (appState.layoutMode === "2-h") { cols = 2; rows = 1; }
        else if (appState.layoutMode === "2-v" || appState.layoutMode === "2") { cols = 1; rows = 2; }
        else if (appState.layoutMode === "1") { cols = 1; rows = 1; }

        const gapX = cols > 1 ? 36 : 0;
        const capSpace = appState.captionStyle === "below" ? 48 : 0;
        const gapY = rows > 1 ? (32 + capSpace) : capSpace;

        const maxSlotW = (availW - gapX * (cols - 1)) / cols;
        const maxSlotH = (availH - gapY * (rows - 1) - (rows === 1 ? capSpace : 0)) / rows;

        let drawW = maxSlotW, drawH = drawW * 0.75;
        if (drawH > maxSlotH) { drawH = maxSlotH; drawW = drawH * (4 / 3); }

        const startX = marginX + (availW - (cols * drawW + (cols - 1) * gapX)) / 2;
        const startY = topY + (availH - (rows * drawH + (rows - 1) * gapY + (rows === 1 ? capSpace : 0))) / 2;

        for (let idx = 0; idx < pagePhotos.length; idx++) {
          const r = Math.floor(idx / cols), c = idx % cols;
          const x = startX + c * (drawW + gapX), y = startY + r * (drawH + gapY);
          const img = await loadImageElement(pagePhotos[idx].compositeCache);
          ctx.drawImage(img, x, y, drawW, drawH);
          if (appState.captionStyle === "below" && pagePhotos[idx].caption) {
            ctx.fillStyle = "#000"; ctx.font = "700 28px " + fontFamily; ctx.textAlign = "center";
            ctx.fillText(pagePhotos[idx].caption.split("\n").join(" "), x + drawW / 2, y + drawH + 34);
          }
        }
        pageResults.push({ dataUrl: pageCanvas.toDataURL("image/jpeg", 0.92), width: PAGE_W, height: PAGE_H, isLandscape });
      }
      return pageResults;
    }

    function dataUrlToUint8Array(dataUrl) {
      const binary = atob(dataUrl.split(",")[1]);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      return bytes;
    }

    function buildNativePdfFromPages(pageResults) {
      const pageImages = pageResults.map(p => ({
        bytes: dataUrlToUint8Array(p.dataUrl), width: p.width, height: p.height,
        pdfW: p.isLandscape ? "841.89" : "595.28", pdfH: p.isLandscape ? "595.28" : "841.89"
      }));
      const N = pageImages.length, totalObjects = 2 + N * 3;
      const offsets = new Array(totalObjects + 1).fill(0), chunks = [];
      let currentLen = 0;
      const encoder = new TextEncoder();
      const pushStr = (s) => { const b = encoder.encode(s); chunks.push(b); currentLen += b.length; };
      const pushBytes = (b) => { chunks.push(b); currentLen += b.length; };

      pushStr("%PDF-1.4\n%\xE2\xE3\xCF\xD3\n");
      offsets[1] = currentLen; pushStr("1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n");
      const kids = Array.from({ length: N }, (_, i) => (3 + i * 3) + " 0 R");
      offsets[2] = currentLen; pushStr("2 0 obj\n<< /Type /Pages /Kids [ " + kids.join(" ") + " ] /Count " + N + " >>\nendobj\n");

      for (let i = 0; i < N; i++) {
        const pId = 3 + i * 3, cId = 4 + i * 3, iId = 5 + i * 3, img = pageImages[i];
        offsets[pId] = currentLen;
        pushStr(pId + " 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 " + img.pdfW + " " + img.pdfH + "] /Resources << /XObject << /Im" + i + " " + iId + " 0 R >> >> /Contents " + cId + " 0 R >>\nendobj\n");
        const cs = "q\n" + img.pdfW + " 0 0 " + img.pdfH + " 0 0 cm\n/Im" + i + " Do\nQ\n";
        offsets[cId] = currentLen;
        pushStr(cId + " 0 obj\n<< /Length " + cs.length + " >>\nstream\n" + cs + "endstream\nendobj\n");
        offsets[iId] = currentLen;
        pushStr(iId + " 0 obj\n<< /Type /XObject /Subtype /Image /Width " + img.width + " /Height " + img.height + " /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length " + img.bytes.length + " >>\nstream\n");
        pushBytes(img.bytes); pushStr("\nendstream\nendobj\n");
      }
      const xrefOffset = currentLen;
      pushStr("xref\n0 " + (totalObjects + 1) + "\n0000000000 65535 f \n");
      for (let id = 1; id <= totalObjects; id++) pushStr(String(offsets[id]).padStart(10, "0") + " 00000 n \n");
      pushStr("trailer\n<< /Size " + (totalObjects + 1) + " /Root 1 0 R >>\nstartxref\n" + xrefOffset + "\n%%EOF");
      return new Blob(chunks, { type: "application/pdf" });
    }

    const CRC_TABLE = (() => {
      const t = new Uint32Array(256);
      for (let n = 0; n < 256; n++) {
        let c = n;
        for (let k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
        t[n] = c >>> 0;
      }
      return t;
    })();

    function crc32(bytes) {
      let crc = 0xFFFFFFFF;
      for (let i = 0; i < bytes.length; i++) crc = (crc >>> 8) ^ CRC_TABLE[(crc ^ bytes[i]) & 0xFF];
      return (crc ^ 0xFFFFFFFF) >>> 0;
    }

    function createZipBlob(files) {
      const encoder = new TextEncoder(), localParts = [], centralParts = [];
      let offset = 0;
      for (const file of files) {
        const nameBytes = encoder.encode(file.name), dataBytes = file.data;
        const crc = crc32(dataBytes), size = dataBytes.length;
        const lh = new Uint8Array(30 + nameBytes.length), lv = new DataView(lh.buffer);
        lv.setUint32(0, 0x04034b50, true); lv.setUint16(4, 20, true); lv.setUint32(14, crc, true);
        lv.setUint32(18, size, true); lv.setUint32(22, size, true); lv.setUint16(26, nameBytes.length, true);
        lh.set(nameBytes, 30); localParts.push(lh, dataBytes);

        const ch = new Uint8Array(46 + nameBytes.length), cv = new DataView(ch.buffer);
        cv.setUint32(0, 0x02014b50, true); cv.setUint16(4, 20, true); cv.setUint16(6, 20, true);
        cv.setUint32(16, crc, true); cv.setUint32(20, size, true); cv.setUint32(24, size, true);
        cv.setUint16(28, nameBytes.length, true); cv.setUint32(42, offset, true);
        ch.set(nameBytes, 46); centralParts.push(ch);
        offset += lh.length + size;
      }
      const centralSize = centralParts.reduce((a, b) => a + b.length, 0);
      const eocd = new Uint8Array(22), ev = new DataView(eocd.buffer);
      ev.setUint32(0, 0x06054b50, true); ev.setUint16(8, files.length, true); ev.setUint16(10, files.length, true);
      ev.setUint32(12, centralSize, true); ev.setUint32(16, offset, true);
      return new Blob([...localParts, ...centralParts, eocd], { type: "application/vnd.openxmlformats-officedocument.wordprocessingml.document" });
    }

    function buildNativeDocxFromPhotos() {
      const encoder = new TextEncoder(), isLandscape = appState.pageOrientation !== "portrait";
      const perPage = getPhotosPerPage(), totalPages = Math.ceil(appState.photos.length / perPage);
      const zipFiles = [
        { name: "[Content_Types].xml", data: encoder.encode('<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Default Extension="jpg" ContentType="image/jpeg"/><Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/></Types>') },
        { name: "_rels/.rels", data: encoder.encode('<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/></Relationships>') }
      ];
      let rels = "";
      appState.photos.forEach((p, i) => {
        zipFiles.push({ name: "word/media/image" + (i + 1) + ".jpg", data: dataUrlToUint8Array(p.compositeCache) });
        rels += '<Relationship Id="rIdImg' + (i + 1) + '" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image' + (i + 1) + '.jpg"/>';
      });
      zipFiles.push({ name: "word/_rels/document.xml.rels", data: encoder.encode('<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' + rels + '</Relationships>') });

      const makeDraw = (rId, id, cx, cy) => '<w:r><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="' + cx + '" cy="' + cy + '"/><wp:docPr id="' + id + '" name="P' + id + '"/><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="' + id + '" name="P' + id + '"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="' + rId + '"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="' + cx + '" cy="' + cy + '"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r>';

      let cols = 2, rows = 2;
      if (appState.layoutMode === "2-h") { cols = 2; rows = 1; }
      else if (appState.layoutMode === "2-v") { cols = 1; rows = 2; }
      else if (appState.layoutMode === "1") { cols = 1; rows = 1; }

      const cy = isLandscape ? (rows === 2 ? 3100000 : 5800000) : (rows === 2 ? 2360000 : 4500000);
      const cx = Math.round(cy * (4 / 3));
      let bodyXml = "";

      for (let p = 0; p < totalPages; p++) {
        const startIdx = p * perPage;
        bodyXml += '<w:tbl><w:tblPr><w:tblW w:w="5000" w:type="pct"/><w:jc w:val="center"/></w:tblPr>';
        for (let r = 0; r < rows; r++) {
          bodyXml += '<w:tr>';
          for (let c = 0; c < cols; c++) {
            const idx = startIdx + r * cols + c, photo = appState.photos[idx];
            bodyXml += '<w:tc><w:tcPr><w:tcW w:w="' + (cols === 2 ? "2500" : "5000") + '" w:type="pct"/></w:tcPr>';
            bodyXml += photo ? ('<w:p><w:pPr><w:jc w:val="center"/><w:spacing w:before="40" w:after="40"/></w:pPr>' + makeDraw("rIdImg" + (idx + 1), idx + 1, cx, cy) + '</w:p>') : '<w:p/>';
            bodyXml += '</w:tc>';
          }
          bodyXml += '</w:tr>';
        }
        bodyXml += '</w:tbl>';
        if (p < totalPages - 1) bodyXml += '<w:p><w:r><w:br w:type="page"/></w:r></w:p>';
      }

      bodyXml += isLandscape
        ? '<w:sectPr><w:pgSz w:w="16838" w:h="11906" w:orient="landscape"/><w:pgMar w:top="500" w:right="567" w:bottom="450" w:left="567"/></w:sectPr>'
        : '<w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="650" w:right="650" w:bottom="650" w:left="650"/></w:sectPr>';

      zipFiles.push({ name: "word/document.xml", data: encoder.encode('<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"><w:body>' + bodyXml + '</w:body></w:document>') });
      return createZipBlob(zipFiles);
    }

