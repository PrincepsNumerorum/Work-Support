    function evaluateModalRule(item, rawVal) {
      const num = parseFloat(rawVal);
      if (isNaN(num)) return { valid: false, message: "数値を入力してください。" };
      if (item.promptType === "cm_min") {
        return num >= item.minVal
          ? { valid: true, message: "✅ 基準適合：計測値 " + num + "cm （基準: " + item.minVal + "cm以上）" }
          : { valid: false, message: "⚠️ 基準未達：計測値 " + num + "cm は基準（" + item.minVal + "cm以上）未満です！" };
      }
      if (item.promptType === "cm_range") {
        return num >= item.minVal
          ? { valid: true, message: "✅ 基準適合：計測値 " + num + "cm （基準目安: " + item.minVal + "～" + item.maxVal + "cm）" }
          : { valid: false, message: "⚠️ 基準未達：計測値 " + num + "cm は基準（" + item.minVal + "cm以上）未満です！" };
      }
      if (item.promptType === "year_limit") {
        const age = new Date().getFullYear() - num;
        return (age >= 0 && age <= item.maxAgeYears)
          ? { valid: true, message: "✅ 基準適合：製造年 " + num + "年 （経過 約" + age + "年 / 3年以内）" }
          : { valid: false, message: "⚠️ 期限注意：製造年 " + num + "年 （使用開始から3年以内が限度）" };
      }
      return { valid: true, message: "入力値: " + num };
