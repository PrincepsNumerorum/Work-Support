    const TARGET_W = 1400;
    const TARGET_H = 1050;

    function isImageFile(file) {
      if (!file) return false;
      if (file.type && file.type.indexOf("image/") === 0) return true;
      const name = String(file.name || "").toLowerCase();
      return [".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".heic", ".heif"].some(ext => name.endsWith(ext));
    }

    function processUploadedImageFile(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement("canvas");
            canvas.width = TARGET_W; canvas.height = TARGET_H;
            const ctx = canvas.getContext("2d");
            ctx.fillStyle = "#ffffff";
            ctx.fillRect(0, 0, TARGET_W, TARGET_H);
            const imgRatio = img.width / img.height;
            const targetRatio = TARGET_W / TARGET_H;
            let drawW, drawH, offsetX, offsetY;
            if (imgRatio >= 1.0) {
              if (imgRatio > targetRatio) {
                drawH = TARGET_H; drawW = img.width * (TARGET_H / img.height); offsetX = (TARGET_W - drawW) / 2; offsetY = 0;
              } else {
                drawW = TARGET_W; drawH = img.height * (TARGET_W / img.width); offsetX = 0; offsetY = (TARGET_H - drawH) / 2;
              }
            } else {
              drawH = TARGET_H; drawW = img.width * (TARGET_H / img.height); offsetX = (TARGET_W - drawW) / 2; offsetY = 0;
            }
            ctx.drawImage(img, offsetX, offsetY, drawW, drawH);
            resolve(canvas.toDataURL("image/jpeg", 0.88));
          };
          img.onerror = reject;
          img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    function renderCompositePhotoDataUrl(photo) {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement("canvas");
          canvas.width = TARGET_W; canvas.height = TARGET_H;
          const ctx = canvas.getContext("2d");
          ctx.fillStyle = "#ffffff";
          ctx.fillRect(0, 0, TARGET_W, TARGET_H);

          ctx.save();
          const rot = (photo.rotation || 0) % 360;
          if (rot === 0) {
            ctx.drawImage(img, 0, 0, TARGET_W, TARGET_H);
          } else {
            ctx.translate(TARGET_W / 2, TARGET_H / 2);
            ctx.rotate((rot * Math.PI) / 180);
            if (rot === 90 || rot === 270) {
              const s = Math.min(TARGET_W / TARGET_H, TARGET_H / TARGET_W);
              ctx.drawImage(img, (-TARGET_W * s) / 2, (-TARGET_H * s) / 2, TARGET_W * s, TARGET_H * s);
            } else {
              ctx.drawImage(img, -TARGET_W / 2, -TARGET_H / 2, TARGET_W, TARGET_H);
            }
          }
          ctx.restore();

          const text = (photo.caption || "").trim();
          const style = appState.captionStyle;
          if (text && (style === "overlay-bl" || style === "overlay-br")) {
            const scale = (Number(appState.fontSizeScale) || 100) / 100;
            const baseFontSize = Math.round(48 * scale);
            const fontFamily = '"Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif';
            ctx.font = "700 " + baseFontSize + "px " + fontFamily;

            const maxBoxWidth = TARGET_W * 0.92;
            const padX = Math.round(38 * scale);
            const padY = Math.round(22 * scale);
            const lines = wrapJapaneseText(ctx, text, maxBoxWidth - padX * 2);
            const lineHeight = Math.round(baseFontSize * 1.3);

            let maxLineW = 0;
            lines.forEach(l => { const m = ctx.measureText(l).width; if (m > maxLineW) maxLineW = m; });
            let boxW = maxLineW + padX * 2;
            const minW = appState.boxWidthMode === "wide" ? TARGET_W * 0.42 : TARGET_W * 0.25;
            if (boxW < minW) boxW = minW;
            if (boxW > maxBoxWidth) boxW = maxBoxWidth;

            const boxH = lines.length * lineHeight + padY * 2;
            const boxX = style === "overlay-br" ? TARGET_W - boxW - 26 : 26;
            const boxY = TARGET_H - boxH - 24;

            ctx.fillStyle = "#ffffff";
            ctx.fillRect(boxX, boxY, boxW, boxH);
            ctx.lineWidth = Math.max(4, Math.round(6 * scale));
            ctx.strokeStyle = "#000000";
            ctx.strokeRect(boxX, boxY, boxW, boxH);

            ctx.fillStyle = "#000000";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            const startY = boxY + padY + lineHeight / 2;
            lines.forEach((line, idx) => ctx.fillText(line, boxX + boxW / 2, startY + idx * lineHeight));
          }
          resolve(canvas.toDataURL("image/jpeg", 0.90));
        };
        img.src = photo.rawDataUrl;
      });
    }

    function wrapJapaneseText(ctx, text, maxWidth) {
      const normalized = String(text).split("\r\n").join("\n").split("\r").join("\n");
      const explicitLines = normalized.split("\n");
      const result = [];
      for (const rawLine of explicitLines) {
        let current = "";
        for (const ch of rawLine) {
          const test = current + ch;
          if (ctx.measureText(test).width > maxWidth && current.length > 0) {
            result.push(current); current = ch;
          } else { current = test; }
        }
        if (current) result.push(current);
      }
      return result.length > 0 ? result : [""];
    }

