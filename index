      if (appState.layoutMode === "4") return 4;
      if (appState.layoutMode === "2-h" || appState.layoutMode === "2-v" || appState.layoutMode === "2") return 2;
      return 1;
    }

    function openDatabase() {
      return new Promise((resolve, reject) => {
        if (!window.indexedDB) return reject(new Error("IndexedDB unavailable"));
        const req = indexedDB.open(DB_NAME, 1);
        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains(STORE_NAME)) db.createObjectStore(STORE_NAME);
        };
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error);
      });
    }

    async function saveStateToDB() {
      const dot = document.getElementById("saveDot");
      const statusText = document.getElementById("saveStatusText");
      try {
        if (dot) dot.style.backgroundColor = "#facc15";

        // Immediate synchronous backup of NetLG-301N & settings to localStorage so data NEVER vanishes
        try {
          localStorage.setItem("landslide_logger_backup_v6", JSON.stringify({
            activeModule: appState.activeModule,
            selectedPurpose: appState.selectedPurpose,
            projectTitle: appState.projectTitle,
            pageOrientation: appState.pageOrientation,
            layoutMode: appState.layoutMode,
            captionStyle: appState.captionStyle,
            fontSizeScale: appState.fontSizeScale,
            boxWidthMode: appState.boxWidthMode,
            purposeData: appState.purposeData,
            loggerData: appState.loggerData
          }));
        } catch (_) {}

        const stateToSave = {
          activeModule: appState.activeModule,
          selectedPurpose: appState.selectedPurpose,
          projectTitle: appState.projectTitle,
          pageOrientation: appState.pageOrientation,
          layoutMode: appState.layoutMode,
          captionStyle: appState.captionStyle,
          fontSizeScale: appState.fontSizeScale,
          boxWidthMode: appState.boxWidthMode,
          purposeData: appState.purposeData,
          loggerData: appState.loggerData,
          photos: appState.photos.map(p => ({
            id: p.id, name: p.name, rawDataUrl: p.rawDataUrl,
            caption: p.caption, templateKey: p.templateKey || "", note: p.note || "", rotation: p.rotation || 0
          }))
        };

        const db = await openDatabase();
        await new Promise((resolve, reject) => {
          const tx = db.transaction(STORE_NAME, "readwrite");
          tx.objectStore(STORE_NAME).put(stateToSave, "current_project");
          tx.oncomplete = () => resolve();
          tx.onerror = () => reject(tx.error);
        });

        const timeStr = new Date().toTimeString().split(" ")[0];
        if (dot) dot.style.backgroundColor = "#4ade80";
        if (statusText) statusText.textContent = "自動保存完了 (" + timeStr + ")";
      } catch (err) {
        if (dot) dot.style.backgroundColor = "#38bdf8";
        if (statusText) statusText.textContent = "ローカル保護保存済";
      }
    }

    async function loadStateFromDB() {
      let loaded = null;
      try {
        const db = await openDatabase();
        loaded = await new Promise((resolve, reject) => {
          const tx = db.transaction(STORE_NAME, "readonly");
          const req = tx.objectStore(STORE_NAME).get("current_project");
          req.onsuccess = () => resolve(req.result);
          req.onerror = () => reject(req.error);
        });
      } catch (_) {}

      if (!loaded) {
        try {
          const raw = localStorage.getItem("landslide_logger_backup_v6");
          if (raw) loaded = JSON.parse(raw);
        } catch (_) {}
      }

      if (loaded && typeof loaded === "object") {
        const defLogger = createDefaultLoggerData();
        appState = {
          ...appState,
          ...loaded,
          purposeData: { ...cloneDeep(PURPOSE_PRESETS), ...(loaded.purposeData || {}) },
          photos: Array.isArray(loaded.photos) ? loaded.photos : [],
          loggerData: {
            ...defLogger,
            ...(loaded.loggerData || {}),
            fields: { ...defLogger.fields, ...((loaded.loggerData && loaded.loggerData.fields) || {}) },
            strainCh: (loaded.loggerData && Array.isArray(loaded.loggerData.strainCh) && loaded.loggerData.strainCh.length === 30)
              ? loaded.loggerData.strainCh : defLogger.strainCh,
            wlAlarms: (loaded.loggerData && Array.isArray(loaded.loggerData.wlAlarms)) ? loaded.loggerData.wlAlarms : defLogger.wlAlarms,
            stAlarms: (loaded.loggerData && Array.isArray(loaded.loggerData.stAlarms)) ? loaded.loggerData.stAlarms : defLogger.stAlarms
          }
        };
      }
    }

