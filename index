      document.getElementById("exportJsonBtn").addEventListener("click", () => {
        const blob = new Blob([JSON.stringify({ version: 6, exportedAt: new Date().toISOString(), state: appState })], { type: "application/json" });
        const site = appState.loggerData.fields.siteNo || appState.projectTitle || "地すべり業務データ";
        triggerDownload(blob, sanitizeFilename(site) + "_backup.json");
      });

      document.getElementById("importJsonInput").addEventListener("change", (e) => {
        const file = e.target.files[0]; if (!file) return;
        const reader = new FileReader();
        reader.onload = async (ev) => {
          try {
            const parsed = JSON.parse(ev.target.result);
            const st = parsed.state || parsed;
            if (st) {
              appState = { ...appState, ...st };
              syncControlsFromState(); renderCandidateChips(); renderLoggerWorkflow(); renderLoggerTablesAndInputs();
              await refreshAllViews(); await saveStateToDB();
              alert("写真およびNetLG-301Nチェックシートの全データを復元しました！");
            }
          } catch (err) { alert("読込エラー: " + err.message); }
          e.target.value = "";
        };
        reader.readAsText(file);
      });
    });
  </script>
</body>
</html>
