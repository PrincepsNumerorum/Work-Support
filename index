    function updateLoggerEvaluationsAndCalculations() {
      const f = appState.loggerData.fields;

      // 1. Main Battery >= 2.7V check
      const batBadge = document.getElementById("batteryStatusBadge");
      const vMain = parseFloat(f.voltMain);
      if (isNaN(vMain)) {
        batBadge.className = "badge-ok";
        batBadge.textContent = "メイン電池: 未入力 (基準2.7V以上)";
      } else if (vMain >= 2.7) {
        batBadge.className = "badge-ok";
        batBadge.textContent = "✅ メイン電池: " + vMain.toFixed(2) + "V (2.7V以上OK)";
      } else {
        batBadge.className = "badge-ng";
        batBadge.textContent = "⚠️ 要電池交換！メイン電池: " + vMain.toFixed(2) + "V (2.7V未満)";
      }

      // 2. Interval match check
      const intBadge = document.getElementById("intervalMatchBadge");
      if (f.wlInterval && f.stInterval) {
        if (f.wlInterval.trim() === f.stInterval.trim()) {
          intBadge.style.color = "#16a34a";
          intBadge.textContent = "(✅ 水位と一致)";
        } else {
          intBadge.style.color = "#dc2626";
          intBadge.textContent = "(⚠️ 水位と不一致！)";
        }
      } else {
        intBadge.textContent = "";
      }

      // 3. Borehole Water Level & Sensor Depth Auto-Calculation
      const holeLen = parseFloat(f.boreholeLength);
      const wlGL = parseFloat(f.waterLevelGL);
      const sensorGL = parseFloat(f.sensorDepthGL);
      const groundEL = parseFloat(f.groundElev);
      const slipGL = parseFloat(f.slipDepth);

      // Auto-update Elevation Water Level = Ground Elev - ①WaterLevelGL
      if (!isNaN(groundEL) && !isNaN(wlGL)) {
        const calcEL = (groundEL - wlGL).toFixed(2);
        f.elevWaterLevel = calcEL;
        const elInput = document.querySelector('[data-lg="elevWaterLevel"]');
        if (elInput) elInput.value = calcEL;
      }

      // Auto-update ②Actual Water Level = ③SensorDepth - ①WaterLevelGL
      if (!isNaN(sensorGL) && !isNaN(wlGL)) {
        const calcActual = (sensorGL - wlGL).toFixed(2);
        f.actualWaterLevel = calcActual;
        const actInput = document.querySelector('[data-lg="actualWaterLevel"]');
        if (actInput) actInput.value = calcActual;
      }

      const msgEl = document.getElementById("depthAssistantText");
      const btnBox = document.getElementById("depthQuickApplyBtns");
      btnBox.innerHTML = "";

      if (!isNaN(holeLen)) {
        // Recommend nice round depth 10cm to 50cm above bottom (holeLen - 0.50 to holeLen - 0.10)
        const minD = holeLen - 0.50;
        const maxD = holeLen - 0.10;
        const candidates = [];

        // Find 0.5m or 0.1m round numbers within [holeLen - 0.50, holeLen - 0.10]
        for (let step = 1; step <= 5; step++) {
          const d = Math.round((holeLen - step * 0.1) * 10) / 10;
          if (d > 0 && !candidates.includes(d.toFixed(1))) {
            candidates.push(d.toFixed(1));
          }
        }

        let html = "・孔底深度 <strong>GL-" + holeLen.toFixed(2) + "m</strong> に対する推奨センサ深度（孔底より10〜50cm上）：<strong>GL-" + minD.toFixed(2) + "m ～ GL-" + maxD.toFixed(2) + "m</strong><br>";

        if (!isNaN(slipGL)) {
          html += "・想定すべり面深度：<strong>GL-" + slipGL.toFixed(2) + "m</strong> ";
          if (!isNaN(sensorGL)) {
            if (sensorGL > slipGL) {
              html += '<span style="color:#b45309;font-weight:700;">（※現在すべり面より深い位置です。水位が孔底付近でやむを得ない場合を除き注意）</span><br>';
            } else {
              html += '<span style="color:#16a34a;font-weight:700;">（✅ すべり面より浅い安全な深度です）</span><br>';
            }
          } else {
            html += "<br>";
          }
        }

        if (!isNaN(sensorGL) && !isNaN(wlGL)) {
          const targetActual = (sensorGL - wlGL).toFixed(2);
          html += '🎯 <strong>現在の設定：</strong>③センサ深度 <strong>GL-' + sensorGL.toFixed(2) + 'm</strong> － ①地下水位 <strong>GL-' + wlGL.toFixed(2) + 'm</strong> ＝ 合わせるべき<strong>②実水位は 【 ' + targetActual + ' m 】</strong> です。';
        }

        msgEl.innerHTML = html;

        candidates.forEach(cVal => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "btn btn-outline btn-sm";
          const diffCm = Math.round((holeLen - parseFloat(cVal)) * 100);
          b.textContent = "③ GL-" + cVal + "m をセット (孔底+" + diffCm + "cm)";
          b.addEventListener("click", () => {
            f.sensorDepthGL = cVal;
            const sInp = document.querySelector('[data-lg="sensorDepthGL"]');
            if (sInp) sInp.value = cVal;
            updateLoggerEvaluationsAndCalculations();
            saveStateToDB();
          });
          btnBox.appendChild(b);
        });
      }
    }

